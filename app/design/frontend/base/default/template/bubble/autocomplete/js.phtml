$helper = $this->helper('bubble_autocomplete');
?>
<?php if ($helper->isEnabled()): ?>
<script type="text/javascript">
//<![CDATA[
document.addEventListener('DOMContentLoaded', function () {
    // Bypass default autocomplete
    Ajax.Autocompleter.prototype.getUpdatedChoices = function() {
        return false;
    };
    jQuery('#search').removeClass('required-entry');

    // init some useful variables
    var priceFormat = <?php echo $this->helper('core')->jsonEncode($helper->getJsPriceFormat()) ?>;
    var baseUrl = '<?php echo $helper->getBaseUrl() ?>';
    var baseUrlMedia = '<?php echo $helper->getBaseUrlMedia() ?>';
    var imgPlaceholder = '<?php echo Mage::getModel('catalog/product')->getSmallImageUrl(100, 100); ?>';

    // --- Typo tolerant: Levenshtein em JS puro ---
    function levenshtein(a, b) {
        var m = a.length, n = b.length, dp = [];
        for (var i = 0; i <= m; i++) {
            dp[i] = [i];
            for (var j = 1; j <= n; j++) {
                dp[i][j] = i === 0 ? j :
                    Math.min(
                        dp[i-1][j] + 1,
                        dp[i][j-1] + 1,
                        dp[i-1][j-1] + (a[i-1] === b[j-1] ? 0 : 1)
                    );
            }
        }
        return dp[m][n];
    }

    function fuzzyMatch(query, name) {
        query = query.toLowerCase();
        name  = name.toLowerCase();

        // match exato (substring) tem prioridade
        if (name.indexOf(query) !== -1) return true;

        // typo tolerant: testa cada palavra do nome
        var words = name.split(' ');
        var threshold = query.length <= 4 ? 1 : 2; // 1 erro p/ palavras curtas, 2 p/ longas
        for (var i = 0; i < words.length; i++) {
            var word = words[i].substring(0, query.length + 2);
            if (levenshtein(query, word) <= threshold) {
                return true;
            }
        }
        return false;
    }

    // constructs the suggestion engine
    var engine = new Bloodhound({
        datumTokenizer: Bloodhound.tokenizers.obj.whitespace('name'),
        queryTokenizer: Bloodhound.tokenizers.whitespace,
        limit: <?php echo $helper->getLimit() ?>,
        <?php if ($helper->getUseLocalStorage()): ?>
        prefetch: {
            url: '<?php echo $this->getUrl('autocomplete/product/json') ?>',
            ttl: <?php echo $helper->getCacheLifetime() * 1000 ?> // milliseconds
        }
        <?php else: ?>
        remote: {url: '<?php echo $this->getUrl('autocomplete/product/json') ?>'}
        <?php endif; ?>
    });

    // kicks off the loading/processing of `local` and `prefetch`
    engine.initialize();

    // Carrega todos os produtos no cache global para o fuzzy fallback
    jQuery.getJSON('<?php echo $this->getUrl('autocomplete/product/json') ?>', function(data) {
        window._bubbleAllProducts = data;
    });

    // Source com fallback fuzzy quando Bloodhound não encontra resultados exatos
    function fuzzySource(query, syncResults, asyncResults) {
        engine.search(query,
            function(exactResults) {
                if (exactResults.length > 0) {
                    syncResults(exactResults);
                } else if (window._bubbleAllProducts) {
                    // sem resultado exato: aplica levenshtein no cache completo
                    var fuzzy = window._bubbleAllProducts.filter(function(p) {
                        return fuzzyMatch(query, p.name);
                    }).slice(0, <?php echo $helper->getLimit() ?>);
                    syncResults(fuzzy);
                } else {
                    syncResults([]);
                }
            },
            function(remoteResults) {
                asyncResults(remoteResults);
            }
        );
    }

    jQuery('#search').typeahead({
        hint: true,
        highlight: true,
        minLength: <?php echo $helper->getMinLength() ?>
    }, {
        name: 'products',
        displayKey: 'name',
        source: fuzzySource,
        templates: {
            empty: '<div class="empty">' +
                '<?php /* echo $this->__('No Result') */ ?>' +  // This will not execute, comment out to avoid text showing at search box
                '</div>',
            suggestion: function (product) {
                var img = imgPlaceholder;
                if (product.thumbnail && product.thumbnail != 'no_selection') {
                    img = baseUrlMedia + product.thumbnail;
                }
                return '<a href="' + baseUrl + product.url_path + '">' +
                    '<div class="image">' +
                    '<img src="' + img + '">' +
                    '</div>' +
                    '<div class="info">' +
                    '<span class="name">' + product.name + '</span>' +
                    '<div class="price-box">' + formatSuggestionPrice(product, priceFormat) + '</div>' +
                    '</div>' +
                    '<div class="clearer"><!-- --></div>' +
                    '</a>';
            }
        }
    });

    jQuery('#search').bind('typeahead:selected', function (obj, product, name) {
        window.location.href = baseUrl + product.url_path;
    });

    function formatSuggestionPrice(product, priceFormat) {
        var price = '';
        switch (product.type_id) {
            case 'grouped':
            case 'configurable':
            case 'bundle':
                price = '<p class="minimal-price">' +
                    '<span class="price-label"><?php echo $this->__('Starting at:') ?>&nbsp;</span>' +
                    '<span class="price">' + formatCurrency(product.min_price, priceFormat, false) + '</span>' +
                    '</p>';
                break;
            default:
                if (parseFloat(product.final_price) < parseFloat(product.price)) {
                    price += '<p class="old-price">' +
                        '<span class="price-label"><?php echo $this->__('Regular Price:') ?>&nbsp;</span>' +
                        '<span class="price">' + formatCurrency(product.price, priceFormat, false) + '</span>' +
                        '</p>' +
                        '<p class="special-price">' +
                        '<span class="price">' +
                        formatCurrency(product.final_price, priceFormat, false) +
                        '</span>' +
                        '</p>';
                } else {
                    price += '<span class="price">' +
                        formatCurrency(product.price, priceFormat, false) +
                        '</span>';
                }
        }

        return price;
    }
});
//]]>
</script>
<?php endif; ?>
